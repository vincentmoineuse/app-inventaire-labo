# Modèle des « Secrets » à renseigner dans Streamlit Cloud (app → Settings → Secrets).
# NE JAMAIS mettre les vraies valeurs dans ce fichier ni sur GitHub.

supabase_url = "https://xxxxxxxxxxxx.supabase.co"
supabase_key = "clé service_role de ton projet Supabase"

# Accès à l'application
mot_de_passe_admin = "mot de passe long pour l'administrateur"   # obligatoire
code_consultation = "code à donner aux visiteurs"                 # facultatif (sans lui : accès libre en lecture seule)
